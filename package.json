    "verify:overlay-fallback": "npx --yes tsx verify_overlay_fallback.ts",
    "verify:summoners": "npx --yes tsx verify_summoners.ts",
    "verify:riot-identity": "npx --yes tsx verify_riot_identity.ts",
    "verify:stats": "npx --yes tsx verify_stats.ts",
    "verify:match": "npx --yes tsx verify_match_lifecycle.ts",
    "verify:jungle": "npx --yes tsx verify_jungle.ts",
    "verify:wave": "npx --yes tsx verify_wave.ts",
    "verify:loss-insights": "npx --yes tsx verify_loss_insights.ts",
    "verify:mayhem": "npx --yes tsx verify_mayhem_bundle.ts && npx --yes tsx verify_mayhem.ts",
