    "verify:mayhem-visibility": "npx --yes tsx verify_mayhem_visibility.ts",
    "verify:mayhem-defaults": "npx --yes tsx verify_mayhem_defaults.ts",
    "verify:mayhem-capture-gating": "npx --yes tsx verify_mayhem_capture_gating.ts",
    "verify:mayhem-poll-watchdog": "npx --yes tsx verify_mayhem_poll_watchdog.ts",
    "verify:mayhem-reroll-refresh": "npx --yes tsx verify_mayhem_reroll_refresh.ts",
    "verify:mayhem-ocr": "npx --yes tsx verify_mayhem_ocr.ts",
    "verify:mayhem-ocr-lines": "npx --yes tsx verify_mayhem_ocr_lines.ts",
    "verify:mayhem-bundle-wiring": "npx --yes tsx verify_mayhem_bundle_wiring.ts",
    "verify:mayhem-fixtures": "npx --yes tsx verify_mayhem_fixtures.ts",
    "verify:mayhem-text-matrix": "npx --yes tsx verify_mayhem_text_matrix.ts",
    "verify:mayhem-dark-cards": "npx --yes tsx verify_mayhem_dark_cards.ts",
    "verify:mayhem-indigo-cards": "npx --yes tsx verify_mayhem_indigo_cards.ts",
    "verify:mayhem-card-variants": "npx --yes tsx verify_mayhem_card_variants.ts",
    "verify:mayhem-pick-selection": "npx --yes tsx verify_mayhem_pick_selection.ts",
    "verify:mayhem-partial-roll": "npx --yes tsx verify_mayhem_partial_roll.ts",
    "verify:mayhem-self-capture": "npx --yes tsx verify_mayhem_self_capture.ts",
    "verify:mayhem-live": "npx --yes tsx verify_mayhem_live.ts",
    "verify:mayhem-monitor": "npx --yes tsx verify_mayhem_monitor.ts",
    "verify:mayhem-offers": "npx --yes tsx verify_mayhem_offers.ts",
    "verify:ocr-geometry-actual": "npx --yes tsx verify_ocr_geometry_actual.ts",
    "verify:real-game": "npx --yes tsx verify_real_game_regressions.ts",
    "verify:overlay-handoff": "node scripts/verify-overlay-handoff.mjs",
    "verify:hud-skins-dom": "node scripts/verify-hud-skins-dom.mjs",
    "verify:global-hotkeys": "npx --yes tsx verify_global_hotkeys.ts",
    "verify:local-extended": "npm run verify:mayhem-ocr && npm run verify:global-hotkeys && npm run verify:presenter-live",
    "verify:presenter-live": "node scripts/probe-presenter.mjs",
    "smoke:native-overlay": "node scripts/smoke-native-overlay.mjs",
    "verify:mayhem-ocr-live-ui": "npx --yes cross-env OT_RUN_LIVE_OCR_UI=1 npm run verify:mayhem-ocr",
    "smoke:keyhook-electron": "npm run electron:build && electron scripts/smoke-keyhook-electron.mjs",
    "verify:augment-schedule": "npx --yes tsx verify_augment_schedule.ts",
    "sync:mayhem": "npx --yes tsx scripts/sync_mayhem_data.ts",
    "verify:play-moments": "npx --yes tsx verify_play_moments.ts",
    "verify:coach": "npx --yes tsx verify_coach.ts",
    "verify:clipper": "npx --yes tsx verify_clipper.ts",
    "verify:game-state": "npx --yes tsx verify_game_state.ts",
    "verify:game-state-live": "npx --yes cross-env OT_LIVE_STATE=1 npm run verify:game-state",
    "verify:electron-paths": "npx --yes tsx verify_electron_paths.ts",
    "verify:packaging": "npx --yes tsx verify_packaging.ts",
    "verify:stale-launcher": "npx --yes tsx verify_stale_launcher_cleanup.ts",
    "verify:ranked": "npx --yes tsx verify_ranked.ts && npx --yes tsx verify_aram_profile.ts",
    "verify:one-trick": "npx --yes tsx verify_one_trick.ts",
    "verify:release": "npm run lint && npm run verify:perf-budget && npm run verify:cues && npm run verify:cue-labels && npm run verify:build-boot-slot && npm run verify:cue-rank && npm run verify:map-scheme && npm run verify:buy-detail && npm run verify:summoner-chip && npm run verify:enemy-respawns && npm run verify:overlay-clock && npm run verify:latency-stats && npm run verify:no-winrate-claims && npm run verify:signal-inventory && npm run verify:vision-validation && npm run verify:icons && npm run verify:catalog && npm run verify:layout && npm run verify:overlay-layout-edges && npm run verify:overlay-bounds && npm run verify:overlay-health && npm run verify:overlay-environment && npm run verify:ps-worker && npm run verify:live-builds && npm run verify:riot-api && npm run verify:destroyed-guards && npm run verify:native-presenter && npm run verify:presenter-frame && npm run verify:presenter-supervisor && npm run verify:overlay-fallback && npm run verify:summoners && npm run verify:stats && npm run verify:match && npm run verify:jungle && npm run verify:wave && npm run verify:loss-insights && npm run verify:ranked && npm run verify:mayhem-reroll-refresh && npm run verify:riot-identity && npm run verify:mayhem && npm run verify:mayhem-match && npm run verify:mayhem-visibility && npm run verify:mayhem-defaults && npm run verify:mayhem-capture-gating && npm run verify:mayhem-poll-watchdog && npm run verify:mayhem-monitor && npm run verify:mayhem-offers && npm run verify:mayhem-ocr && npm run verify:mayhem-ocr-lines && npm run verify:mayhem-fixtures && npm run verify:mayhem-text-matrix && npm run verify:mayhem-dark-cards && npm run verify:mayhem-indigo-cards && npm run verify:mayhem-card-variants && npm run verify:mayhem-pick-selection && npm run verify:mayhem-partial-roll && npm run verify:mayhem-bundle-wiring && npm run verify:mayhem-self-capture && npm run verify:ocr-geometry-actual && npm run verify:global-hotkeys && npm run verify:augment-schedule && npm run verify:play-moments && npm run verify:coach && npm run verify:clipper && npm run verify:clipper-lifecycle && npm run verify:game-state && npm run verify:state-service && npm run verify:game-monitor && npm run verify:ipc-surface && npm run verify:hud-geometry && npm run verify:game-hud-skin && npm run verify:pixel-pet && npm run verify:loading-pet && npm run verify:scouting && npm run verify:appearance-settings && npm run electron:build && npm run build && npm run verify:electron-paths && npm run verify:packaging && npm run verify:stale-launcher && npx tsc --noEmit && npm run verify:purchase-order && npm run verify:app-density && npm run verify:review-fixes",
    "catalog:generate": "npx --yes tsx scripts/generate-catalog.ts",
    "preview": "vite preview",
    "electron": "wait-on tcp:5173 && electron .",
    "electron:build": "tsc -p tsconfig.electron.json && node -e \"require('fs').cpSync('electron/scripts','dist-electron/electron/scripts',{recursive:true})\"",
    "dev:electron": "node scripts/build-keyhook.mjs --optional && npm run electron:build && concurrently -k \"npm run dev\" \"npm run electron\"",
    "dev:electron:win": "dev-electron.cmd",
    "pack": "npm run build && npm run electron:build && npm run build:keyhook && npm run build:presenter && electron-builder --dir",
    "dist": "npm run build && npm run electron:build && npm run build:keyhook && npm run build:presenter && electron-builder",
    "website:dev": "npm --prefix website run dev",
    "website:build": "npm --prefix website run build",
    "icons": "node scripts/generate-icons.mjs",
    "build:keyhook": "node scripts/build-keyhook.mjs",
    "build:presenter": "node scripts/build-presenter.mjs",
    "verify:hud-geometry": "npx --yes tsx verify_hud_geometry.ts",
    "verify:state-service": "npx --yes tsx verify_state_service.ts",
    "verify:clipper-lifecycle": "npx --yes tsx verify_clipper_lifecycle.ts",
