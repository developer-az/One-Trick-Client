{
  "name": "one-trick",
  "private": true,
  "version": "1.7.1-test.18",
  "description": "One Trick — gothic League companion + HUD studio. Authored Pyke / Pantheon / Yone, live catalog for every champion, click-through overlay.",
  "author": "Az040",
  "repository": {
    "type": "git",
    "url": "https://github.com/developer-az/One-Trick-Client.git"
  },
  "main": "dist-electron/electron/main.js",
  "build": {
    "appId": "com.onetrick.app",
    "productName": "One Trick",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "src/data/mayhem/bundle.json",
      "electron/scripts/**/*",
      "!scripts/inject-test-keys.ps1"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "asarUnpack": [
      "electron/scripts/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "executableName": "OneTrick",
      "legalTrademarks": "One Trick",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "One.Trick.${version}.${ext}",
      "target": [
        "zip",
        "nsis"
      ],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "One Trick",
      "uninstallDisplayName": "One Trick",
      "artifactName": "One.Trick.Setup.${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "extraFiles": [
      {
        "from": "packaging/INSTALL.txt",
        "to": "INSTALL.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "packaging/licenses/GPL-3.0.txt",
        "to": "licenses/GPL-3.0.txt"
      }
    ],
    "extraResources": [
      {
        "from": "native/bin/onetrick-keys.exe",
        "to": "onetrick-keys.exe"
      },
      {
        "from": "native/bin/onetrick-presenter.exe",
        "to": "onetrick-presenter.exe"
      },
      {
        "from": "native/bin/ffmpeg.exe",
        "to": "ffmpeg.exe"
      }
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "record:game": "node scripts/perf/record-live-client.mjs",
    "lint": "eslint .",
    "verify:cues": "npx --yes tsx verify_overlay_cues.ts",
    "verify:cue-labels": "npx --yes tsx verify_cue_labels.ts",
    "verify:build-boot-slot": "npx --yes tsx verify_build_boot_slot.ts",
    "verify:cue-rank": "npx --yes tsx verify_cue_rank.ts",
    "verify:map-scheme": "npx --yes tsx verify_map_scheme.ts",
    "verify:buy-detail": "npx --yes tsx verify_buy_detail.ts",
    "verify:summoner-chip": "npx --yes tsx verify_summoner_chip.ts",
    "verify:enemy-respawns": "npx --yes tsx verify_enemy_respawns.ts",
