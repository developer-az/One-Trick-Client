{
  "name": "pyke-dominator",
  "private": true,
  "version": "1.1.0-beta.1",
  "description": "One Trick — League companion for Pyke / Pantheon Support + Yone Mid. LCU export and in-game overlay.",
  "author": "Az040",
  "repository": {
    "type": "git",
    "url": "https://github.com/developer-az/One-Trick-Client.git"
  },
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.onetrick.app",
    "productName": "One Trick",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/uiohook-napi/**"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "verify:cues": "npx --yes tsx verify_overlay_cues.ts",
    "verify:icons": "npx --yes tsx verify_champion_icons.ts",
    "preview": "vite preview",
    "electron": "wait-on tcp:5173 && electron .",
    "electron:build": "tsc -p tsconfig.electron.json",
    "dev:electron": "npm run electron:build && concurrently -k \"npm run dev\" \"npm run electron\"",
    "dev:electron:win": "dev-electron.cmd",
    "pack": "npm run build && npm run electron:build && electron-builder --dir",
    "dist": "npm run build && npm run electron:build && electron-builder",
    "website:dev": "npm --prefix website run dev",
    "website:build": "npm --prefix website run build",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "wait-on": "^9.0.3"
  }
}
