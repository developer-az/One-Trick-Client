    "verify:riot-api": "npx --yes tsx verify_riot_api.ts",
    "verify:live-builds:live": "npx --yes tsx verify_live_builds.ts --live",
    "verify:destroyed-guards": "npx --yes tsx verify_destroyed_guards.ts",
    "verify:purchase-order": "npx --yes tsx verify_purchase_order.ts",
    "verify:app-density": "npx --yes tsx verify_app_density.ts",
    "verify:appearance-settings": "npx --yes tsx verify_appearance_settings.ts",
    "verify:pixel-pet": "npx --yes tsx verify_pixel_pet.ts",
    "verify:loading-pet": "npx --yes tsx verify_loading_pet.ts",
    "verify:loading-card": "npx --yes tsx verify_loading_card.ts",
    "verify:client-revamp": "npx --yes tsx verify_client_revamp.ts",
    "verify:orbit-client": "npx --yes tsx verify_orbit_client.ts",
    "verify:loading-roam": "npx --yes tsx verify_loading_roam.ts",
    "verify:champ-accent": "npx --yes tsx verify_champ_accent.ts",
    "verify:prematch-loading": "npx --yes tsx verify_prematch_loading.ts",
    "verify:prematch-lifecycle": "npx --yes tsx verify_prematch_lifecycle.ts",
    "verify:scouting": "npx --yes tsx verify_scouting.ts",
    "verify:scouting-identity": "npx --yes tsx verify_scouting_identity.ts",
    "verify:review-fixes": "npx --yes tsx verify_review_fixes.ts",
    "verify:hud-skins": "npx --yes tsx verify_hud_skins.ts",
    "verify:game-hud-skin": "npx --yes tsx verify_game_hud_skin.ts"
