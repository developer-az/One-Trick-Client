{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/studio", "destination": "/studio/index.html" },
    { "source": "/studio/", "destination": "/studio/index.html" },
    { "source": "/download", "destination": "/download/index.html" },
    { "source": "/download/", "destination": "/download/index.html" },
    { "source": "/getting-started", "destination": "/getting-started/index.html" },
    { "source": "/getting-started/", "destination": "/getting-started/index.html" },
    { "source": "/overlay", "destination": "/overlay/index.html" },
    { "source": "/overlay/", "destination": "/overlay/index.html" },
    { "source": "/troubleshooting", "destination": "/troubleshooting/index.html" },
    { "source": "/troubleshooting/", "destination": "/troubleshooting/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/about/", "destination": "/about/index.html" }
  ],
  "headers": [
    {
      "source": "/api/v1/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
